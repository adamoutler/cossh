<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Identity and Profile Encrypted SharedPreferences -->
    <exclude domain="sharedpref" path="secret_ssh_profiles.xml" />
    <exclude domain="sharedpref" path="secret_ssh_profiles_fallback.xml" />
    <exclude domain="sharedpref" path="secret_ssh_identities.xml" />
    <exclude domain="sharedpref" path="secret_ssh_identities_fallback.xml" />
    
    <!-- Trust On First Use (TOFU) / MITM Prevention -->
    <exclude domain="file" path="ssh_known_hosts" />
    
    <!-- Exclude EncryptedSharedPreferences Master Key -->
    <exclude domain="sharedpref" path="crypto_prefs.xml" />

    <!-- Exclude plaintext crash dumps -->
    <exclude domain="file" path="secure_crashes" />

    <!-- Billing Preferences to prevent entitlement tampering/cloning across backups -->
    <exclude domain="sharedpref" path="BillingPrefs.xml" />

    <!-- Security Audit logs and integrity anchors -->
    <exclude domain="sharedpref" path="security_audit_anchor_prefs.xml" />
    <exclude domain="file" path="security_audit" />
</full-backup-content>