{
  "prevent-curl-bypass": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/prevent-curl-bypass.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "qa-gate": {
    "PreToolUse": [
      {
        "matcher": "call_mcp_tool|mcp_.*|complete_work|transition_ticket|update_ticket|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/qa-gate.py",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "git-push-after": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/git-push-after.sh",
            "timeout": 3600
          }
        ]
      }
    ]
  },
  "remind-comment": {
    "PostToolUse": [
      {
        "matcher": "call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/remind-comment.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
